String lcdLine2Cache = "";

void lcdShow(const String& line1, const String& line2 = "") {
  if (line1 == lcdLine1Cache && line2 == lcdLine2Cache) return;
  lcdLine1Cache = line1;
  lcdLine2Cache = line2;

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(line1);
  lcd.setCursor(0, 1);
  lcd.print(line2);
}

void loadOfflineCodesFromStorage() {
  preferences.begin("doorlock", true);
  for (int i = 0; i < 10; i++) {
    offlineCodes[i] = preferences.getString(("code" + String(i)).c_str(), "");
    codeUsed[i] = preferences.getBool(("used" + String(i)).c_str(), false);
  }
  preferences.end();
}

void saveOfflineCode(int index, const String& code) {
  offlineCodes[index] = code;
  codeUsed[index] = false;
  preferences.begin("doorlock", false);
  preferences.putString(("code" + String(index)).c_str(), code);
  preferences.putBool(("used" + String(index)).c_str(), false);
  preferences.end();
}

void markCodeUsedLocally(int index) {
  codeUsed[index] = true;
  preferences.begin("doorlock", false);
  preferences.putBool(("used" + String(index)).c_str(), true);
  preferences.end();
}

void reportUsedCodesToBackend() {
  StaticJsonDocument<256> doc;
  doc["type"] = "codes_used_report";
  JsonArray arr = doc.createNestedArray("usedIndices");
  for (int i = 0; i < 10; i++) {
    if (codeUsed[i]) arr.add(i);
  }
  String out;
  serializeJson(doc, out);
  Serial.println("ส่งรายงานรหัสที่ใช้แล้ว: " + out);
  webSocket.sendTXT(out);
}

void relayOff() {
  digitalWrite(RELAY_PIN, RELAY_ACTIVE_LOW ? HIGH : LOW);
}

void relayOn() {
  digitalWrite(RELAY_PIN, RELAY_ACTIVE_LOW ? LOW : HIGH);
}

void showReadyStatus() {
  if (apModeActive) return; // อยู่ AP mode อยู่แล้ว ไม่ต้องเขียนทับจอ "Connect to WiFi:" ด้วย event จาก WS reconnect เบื้องหลัง

  if (WiFi.status() != WL_CONNECTED) {
    lcdShow("No Internet", "Press 1x=AP");
  } else if (wsConnected) {
    lcdShow(ROOM_LABEL, "Ready");
  } else {
    lcdShow("Server offline", "Press 1x=AP");
  }
}

void confirmUnlock() {
  doorArmed = false;
  lastShownArmSecond = -1;
  String confirmedRequestId = armedRequestId;

  Serial.println("Physical button pressed, unlocking...");
  relayOn();
  for (int remaining = UNLOCK_DURATION_SEC; remaining > 0; remaining--) {
    lcdShow("Door Unlocked!", "Lock in " + String(remaining) + "s");
    unsigned long stepStart = millis();
    while (millis() - stepStart < 1000) {
      webSocket.loop();
      delay(10);
    }
  }
  relayOff();
  Serial.println("Door relay reset (locked again)");
  showReadyStatus();

  StaticJsonDocument<128> doc;
  doc["type"] = "unlock_confirmed";
  doc["requestId"] = confirmedRequestId;
  String out;
  serializeJson(doc, out);
  webSocket.sendTXT(out);
}

void checkArmExpiry() {
  if (!doorArmed) return;

  long msLeft = (long)armedUntilMillis - (long)millis();
  if (msLeft <= 0) {
    doorArmed = false;
    lastShownArmSecond = -1;
    showReadyStatus();

    StaticJsonDocument<128> doc;
    doc["type"] = "arm_expired";
    doc["requestId"] = armedRequestId;
    String out;
    serializeJson(doc, out);
    webSocket.sendTXT(out);
    return;
  }

  int secondsLeft = (msLeft + 999) / 1000;
  if (secondsLeft != lastShownArmSecond) {
    lastShownArmSecond = secondsLeft;
    lcdShow("Ready to unlock!", "Press in " + String(secondsLeft) + "s");
  }
}


// เช็คว่าปุ่มถูกกดค้างมาครบ 5 วิหรือยัง เรียกทุกรอบ loop() ไม่ว่าจะอยู่โหมดไหน/สถานะไหนก็ตาม
// ทำงานได้เสมอไม่ขึ้นกับ doorArmed/apModeActive เพราะปุ่มรีเซ็ตต้องใช้ได้ทุกสถานการณ์รวมถึงตอนระบบค้าง
void checkResetHold() {
  bool current = digitalRead(BUTTON_PIN);

  if (current == LOW) { // ปุ่มกำลังถูกกดอยู่ (active-low)
    if (buttonPressStartMillis == 0) {
      buttonPressStartMillis = millis(); // เพิ่งเริ่มกด บันทึกเวลาเริ่มไว้
    } else if (!resetTriggered && millis() - buttonPressStartMillis >= RESET_HOLD_MS) {
      resetTriggered = true;
      Serial.println("กดปุ่มค้างครบ 5 วินาที กำลังรีสตาร์ทบอร์ด...");
      lcdShow("Resetting...", "Please wait");
      delay(300); // เผื่อเวลาให้ Serial/LCD พิมพ์ทันก่อนบอร์ดดับ
      ESP.restart();
    }
  } else {
    buttonPressStartMillis = 0; // ปล่อยปุ่มแล้ว รีเซ็ตตัวจับเวลา (ไม่ครบ 5 วิ ถือว่ายกเลิก)
  }
}

void checkButton() {
  bool current = digitalRead(BUTTON_PIN);
  bool pressedEdge = (buttonPrevState == HIGH && current == LOW); // จับจังหวะกดลงครั้งเดียว กันนับซ้ำตอนกดค้าง
  buttonPrevState = current;

  if (!pressedEdge) return;

  if (doorArmed) {
    confirmUnlock();
    return;
  }

  // ไม่ได้ armed อยู่ -> กด 1 ครั้งเข้า AP mode ได้เฉพาะตอนออฟไลน์/ต่อ backend ไม่ได้เท่านั้น
  if (!apModeActive && !wsConnected) {
    startOfflineAP();
  }
}

// เช็คปุ่มระหว่างอยู่ใน AP mode อยู่แล้ว — กด 1 ครั้งออกจาก AP mode ได้ทันที ไม่ต้องรอเน็ตกลับมาเอง
void checkApExitButton() {
  bool current = digitalRead(BUTTON_PIN);
  bool pressedEdge = (buttonPrevState == HIGH && current == LOW);
  buttonPrevState = current;

  if (pressedEdge) {
    Serial.println("กดปุ่มออกจาก AP mode ด้วยตนเอง");
    stopOfflineAP();
  }
}


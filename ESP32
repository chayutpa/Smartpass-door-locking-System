void handleOfflineUnlock() {
  if (millis() < lockoutUntil) {
    unsigned long secondsLeft = (lockoutUntil - millis()) / 1000 + 1;
    String body = "<h2>ลองใหม่อีกครั้งใน " + String(secondsLeft) + " วินาที</h2>"
                  "<div class='msg-error'>กรอกรหัสผิดหลายครั้งเกินไป</div>"
                  "<a href='/'>← ย้อนกลับ</a>";
    offlineServer.send(200, "text/html; charset=utf-8", renderPage(body));
    return;
  }

  String code = offlineServer.arg("code");
  int matchIndex = -1;
  for (int i = 0; i < 10; i++) {
    if (offlineCodes[i].length() > 0 && code == offlineCodes[i]) { matchIndex = i; break; }
  }

  bool isValidUnusedCode = (matchIndex != -1 && !codeUsed[matchIndex]);

  if (!isValidUnusedCode) {
    failedAttempts++;
    Serial.println("กรอกรหัสผิด ครั้งที่ " + String(failedAttempts));

    if (failedAttempts >= ATTEMPTS_BEFORE_LOCKOUT) {
      lockoutUntil = millis() + currentLockoutDurationMs;
      Serial.println("Lock การกรอกรหัส " + String(currentLockoutDurationMs / 1000) + " วินาที");
      failedAttempts = 0;
      currentLockoutDurationMs = min(currentLockoutDurationMs * 2, MAX_LOCKOUT_MS);
    }

    String message = (matchIndex != -1 && codeUsed[matchIndex]) ? "รหัสนี้ถูกใช้ไปแล้ว" : "รหัสไม่ถูกต้อง";
    String body = "<h2>ไม่สำเร็จ</h2><div class='msg-error'>" + message + "</div><a href='/'>← ย้อนกลับ</a>";
    offlineServer.send(200, "text/html; charset=utf-8", renderPage(body));
    return;
  }

  failedAttempts = 0;
  currentLockoutDurationMs = 30000;

  markCodeUsedLocally(matchIndex);

  String body = "<h2>ปลดล็อกสำเร็จ</h2>"
                "<div class='msg-success'>กำลังกลับไปหน้าแรก...</div>";
  String successHtml = "<!DOCTYPE html><html><head><meta charset='utf-8'>"
                        "<meta http-equiv='refresh' content='3;url=/'>"
                        "<meta name='viewport' content='width=device-width, initial-scale=1'>"
                        "<style>*{box-sizing:border-box;margin:0;padding:0;}"
                        "body{font-family:-apple-system,'Segoe UI',Roboto,sans-serif;"
                        "background:linear-gradient(180deg,#eef1f6 0%,#e6ebf7 100%);"
                        "min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;}"
                        ".card{background:#fff;border-radius:20px;padding:32px 28px;max-width:340px;width:100%;"
                        "box-shadow:0 20px 50px rgba(37,99,235,0.18);text-align:center;}"
                        ".card h2{font-size:20px;margin-bottom:8px;}"
                        ".msg-success{color:#15803d;background:#f0fdf4;border:1px solid #bbf7d0;"
                        "padding:10px 14px;border-radius:10px;font-size:14px;}"
                        "</style></head><body><div class='card'>" + body + "</div></body></html>";
  offlineServer.send(200, "text/html; charset=utf-8", successHtml);

  Serial.println("Unlocking door (offline code)...");
  relayOn();
  for (int remaining = UNLOCK_DURATION_SEC; remaining > 0; remaining--) {
    lcdShow("Door Unlocked!", "Lock in " + String(remaining) + "s");
    unsigned long stepStart = millis();
    while (millis() - stepStart < 1000) {
      dnsServer.processNextRequest();
      offlineServer.handleClient();
      delay(10);
    }
  }
  relayOff();
  Serial.println("Door relay reset (locked again)");
  lcdShow("Connect to WiFi:", String(OFFLINE_AP_SSID));
}

void startOfflineAP() {
  if (apModeActive) return;
  Serial.println("เปิดโหมดฮอตสปอตสำรอง");

  webSocket.disconnect(); // ตัดการเชื่อมต่อเดิมทิ้ง กันสถานะ wsConnected ค้างเป็น true จากก่อนหน้า
  wsConnected = false;

  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(OFFLINE_AP_SSID);

  IPAddress apIP = WiFi.softAPIP();
  dnsServer.start(DNS_PORT, "*", apIP);

  offlineServer.on("/generate_204", handleCaptivePortalRedirect);
  offlineServer.on("/gen_204", handleCaptivePortalRedirect);
  offlineServer.on("/hotspot-detect.html", handleCaptivePortalRedirect);
  offlineServer.on("/library/test/success.html", handleCaptivePortalRedirect);
  offlineServer.on("/ncsi.txt", handleCaptivePortalRedirect);
  offlineServer.on("/connecttest.txt", handleCaptivePortalRedirect);
  offlineServer.onNotFound(handleCaptivePortalRedirect);

  offlineServer.begin();
  apModeActive = true;
  buttonPrevState = digitalRead(BUTTON_PIN); // sync สถานะปุ่มก่อนเข้าโหมด AP กันจับ edge ผิดพลาดตอนสลับโหมด
  lcdShow("Connect to WiFi:", String(OFFLINE_AP_SSID));
}

void stopOfflineAP() {
  if (!apModeActive) return;
  Serial.println("ปิดโหมดฮอตสปอตสำรอง");
  dnsServer.stop();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  apModeActive = false;
  buttonPrevState = digitalRead(BUTTON_PIN); // sync สถานะปุ่มก่อนกลับโหมดปกติ กันจับ edge ผิดพลาดตอนสลับโหมด
  showReadyStatus();

  webSocket.disconnect();
  if (USE_TLS) {
    webSocket.beginSSL(WS_HOST, WS_PORT, WS_PATH);
  } else {
    webSocket.begin(WS_HOST, WS_PORT, WS_PATH);
  }
}

void webSocketEvent(WStype_t type, uint8_t* payload, size_t length) {
  switch (type) {
    case WStype_DISCONNECTED:
      Serial.println("[WS] disconnected");
      wsConnected = false;
      showReadyStatus();
      break;

    case WStype_CONNECTED:
      Serial.println("[WS] connected to backend");
      wsConnected = true;
      showReadyStatus();
      reportUsedCodesToBackend();
      break;

    case WStype_TEXT: {
      StaticJsonDocument<1024> doc;
      DeserializationError err = deserializeJson(doc, payload, length);
      if (err) return;

      String msgType = doc["type"] | "";
      if (msgType == "arm") {
        armedRequestId = doc["requestId"] | "";
        doorArmed = true;
        armedUntilMillis = millis() + ARM_WINDOW_MS;
        lastShownArmSecond = -1;

        StaticJsonDocument<128> ackDoc;
        ackDoc["type"] = "armed_ack";
        ackDoc["requestId"] = armedRequestId;
        String out;
        serializeJson(ackDoc, out);
        webSocket.sendTXT(out);
      } else if (msgType == "sync_codes") {
        JsonArray codes = doc["codes"].as<JsonArray>();
        for (JsonObject c : codes) {
          int idx = c["index"];
          String code = c["code"].as<String>();
          bool usedFromBackend = c["used"] | false;
          if (idx >= 0 && idx < 10) {
            if (offlineCodes[idx] != code) {
              saveOfflineCode(idx, code);
            } else if (usedFromBackend && !codeUsed[idx]) {
              markCodeUsedLocally(idx);
            }
          }
        }
        Serial.println("ซิงก์ชุดรหัสฉุกเฉินจาก backend เรียบร้อย");
      }
      break;
    }

    default:
      break;
  }
}

void setup() {
  loadOfflineCodesFromStorage();
  Serial.begin(115200);
  pinMode(RELAY_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  relayOff();
  buttonPrevState = digitalRead(BUTTON_PIN);

  Wire.begin();
  lcd.init();
  lcd.backlight();
  lcdShow(ROOM_LABEL, "Starting...");

  lcdShow("Connecting WiFi", String(WIFI_SSID));
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("WiFi connected, IP: ");
  Serial.println(WiFi.localIP());

  lcdShow("WiFi Connected", WiFi.localIP().toString());
  delay(1500);

  lcdShow("Connecting", "to Server...");
  if (USE_TLS) {
    webSocket.beginSSL(WS_HOST, WS_PORT, WS_PATH);
  } else {
    webSocket.begin(WS_HOST, WS_PORT, WS_PATH);
  }
  webSocket.onEvent(webSocketEvent);
  webSocket.setReconnectInterval(10000);

  webSocket.enableHeartbeat(15000, 3000, 2);
  offlineServer.on("/", handleOfflineRoot);
  offlineServer.on("/unlock", HTTP_POST, handleOfflineUnlock);
}

unsigned long lastWifiCheck = 0;

void loop() {
  checkResetHold(); // เช็คก่อนสุดเสมอ ไม่ขึ้นกับโหมดไหนๆ เพื่อให้ปุ่มรีเซ็ตใช้ได้ตลอดเวลา

  if (millis() - lastWifiCheck > 3000) {
    lastWifiCheck = millis();
    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("WiFi หลุด! กำลังพยายามต่อใหม่...");
      WiFi.reconnect();
    }
  }

  webSocket.loop();

  if (apModeActive) {
    dnsServer.processNextRequest();
    offlineServer.handleClient();
    checkApExitButton();

    if (wsConnected) {
      Serial.println("Server กลับมาใช้งานได้แล้ว ออกจาก AP mode อัตโนมัติ");
      stopOfflineAP();
    }
  } else {
    checkArmExpiry();
    checkButton();
  }
}
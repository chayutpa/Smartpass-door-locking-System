# MongoDB Atlas connection string
# หาได้จาก Atlas -> Database -> Connect -> Drivers -> Node.js
MONGODB_URI=

# ใช้เข้ารหัส JWT ของผู้ใช้ที่ล็อกอินผ่านหน้าเว็บ (สุ่ม string ยาวๆ)
JWT_SECRET=

# หมายเหตุ: เวอร์ชันหลายห้องนี้ไม่มี ESP32_DEVICE_SECRET ตัวเดียวอีกต่อไป
# แต่ละห้องจะมี secret ของตัวเอง สุ่มโดยระบบตอน admin สร้างห้องผ่านหน้าเว็บ /admin

# origin ของ frontend (สำหรับตั้งค่า CORS)
FRONTEND_ORIGIN=

PORT=4000

SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_AUTHORIZE_URL=https://service.eng.rmuti.ac.th/sso/oauth2/authorize/
SSO_TOKEN_URL=https://service.eng.rmuti.ac.th/sso/oauth2/token/
SSO_USERINFO_URL=https://service.eng.rmuti.ac.th/sso/oauth2/resources/user/
SSO_SCOPE=read
